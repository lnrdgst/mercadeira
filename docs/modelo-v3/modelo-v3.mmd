erDiagram
    USUARIO {
        uuid id PK
        varchar nome
        varchar email UK
        varchar senha_hash
        timestamptz criado_em
        timestamptz atualizado_em
    }
    FAMILIA {
        uuid id PK
        varchar nome
        varchar codigo_ingresso UK
        varchar status
        uuid criada_por_usuario_id FK
        timestamptz criada_em
        timestamptz atualizada_em
    }
    MEMBRO_FAMILIA {
        uuid id PK
        uuid familia_id FK
        uuid usuario_id FK
        varchar papel
        varchar status
        varchar apelido
        timestamptz criado_em
        timestamptz atualizado_em
    }
    SOLICITACAO_ENTRADA_FAMILIA {
        uuid id PK
        uuid familia_id FK
        uuid solicitante_usuario_id FK
        varchar status
        timestamptz solicitada_em
        uuid resolvida_por_membro_familia_id FK
        timestamptz resolvida_em
    }
    LISTA_COMPRA {
        uuid id PK
        uuid familia_id FK
        varchar nome
        varchar categoria
        varchar estabelecimento
        varchar status
        uuid criada_por_membro_familia_id FK
        timestamptz criada_em
        timestamptz atualizada_em
    }
    PARTICIPANTE_LISTA {
        uuid id PK
        uuid lista_compra_id FK
        uuid membro_familia_id FK
        timestamptz entrou_em
        timestamptz saiu_em
    }
    ITEM_LISTA {
        uuid id PK
        uuid lista_compra_id FK
        varchar descricao
        numeric quantidade
        varchar unidade_medida
        varchar marca
        text observacoes
        integer ordem_exibicao
        timestamptz removido_em
        uuid adicionado_por_membro_familia_id FK
        timestamptz criado_em
        timestamptz atualizado_em
    }
    COMPRA {
        uuid id PK
        uuid lista_compra_id FK UK
        uuid iniciada_por_membro_familia_id FK
        varchar nome_lista_snapshot
        varchar categoria_snapshot
        varchar estabelecimento_snapshot
        varchar status
        timestamptz iniciada_em
        timestamptz finalizada_em
        timestamptz reaberta_em
        uuid reaberta_por_membro_familia_id FK
    }
    PARTICIPANTE_COMPRA {
        uuid id PK
        uuid compra_id FK
        uuid participante_lista_origem_id FK UK
        uuid membro_familia_id FK
        varchar nome_snapshot
        varchar papel_snapshot
        timestamptz gerado_em
    }
    ITEM_COMPRA {
        uuid id PK
        uuid compra_id FK
        uuid item_lista_origem_id FK UK
        boolean adicionado_durante_compra
        integer ordem_exibicao
        varchar descricao_snapshot
        numeric quantidade_snapshot
        varchar unidade_medida_snapshot
        varchar marca_snapshot
        text observacoes_snapshot
        varchar status
        uuid marcado_por_membro_familia_id FK
        timestamptz marcado_em
        varchar decisao_remocao
        uuid remocao_solicitada_por_membro_familia_id FK
        timestamptz remocao_solicitada_em
        uuid remocao_resolvida_por_membro_familia_id FK
        timestamptz remocao_resolvida_em
    }

    USUARIO ||--o{ FAMILIA : cria
    USUARIO ||--o{ MEMBRO_FAMILIA : possui_vinculo
