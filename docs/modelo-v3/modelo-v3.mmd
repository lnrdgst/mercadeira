    FAMILIA ||--o{ MEMBRO_FAMILIA : possui
    FAMILIA ||--o{ SOLICITACAO_ENTRADA_FAMILIA : recebe
    FAMILIA ||--o{ LISTA_COMPRA : possui
    MEMBRO_FAMILIA ||--o{ SOLICITACAO_ENTRADA_FAMILIA : resolve
    MEMBRO_FAMILIA ||--o{ LISTA_COMPRA : cria
    LISTA_COMPRA ||--o{ PARTICIPANTE_LISTA : possui
    MEMBRO_FAMILIA ||--o{ PARTICIPANTE_LISTA : participa
    LISTA_COMPRA ||--o{ ITEM_LISTA : possui
    MEMBRO_FAMILIA ||--o{ ITEM_LISTA : adiciona
    LISTA_COMPRA ||--o| COMPRA : origina
    MEMBRO_FAMILIA ||--o{ COMPRA : inicia
    MEMBRO_FAMILIA ||--o{ COMPRA : reabre
    COMPRA ||--o{ PARTICIPANTE_COMPRA : possui
    PARTICIPANTE_LISTA ||--o| PARTICIPANTE_COMPRA : origina
    MEMBRO_FAMILIA ||--o{ PARTICIPANTE_COMPRA : integra
    COMPRA ||--o{ ITEM_COMPRA : possui
